/*
  # Empêche le MIME sniffing
  X-Content-Type-Options: nosniff

  # Limite les infos de referrer envoyées aux sites externes
  Referrer-Policy: strict-origin-when-cross-origin

  # Protection anti-clickjacking
  X-Frame-Options: SAMEORIGIN

  # Active la protection XSS legacy des vieux navigateurs
  X-XSS-Protection: 1; mode=block

  # Forcer HTTPS sur les prochaines visites (1 an)
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

  # Limite les APIs navigateur accessibles
  Permissions-Policy: camera=(), microphone=(), geolocation=(), accelerometer=(), gyroscope=(), magnetometer=(), usb=(), payment=(), interest-cohort=()

  # Contrôle des ressources croisées (bon compromis pour site statique)
  Cross-Origin-Resource-Policy: same-site
  Cross-Origin-Opener-Policy: same-origin-allow-popups

  # Réduit l'indexation des assets techniques
  X-Robots-Tag: noarchive

  # Découverte agentique / ressources machine-readable
  Link: </llms.txt>; rel="describedby"; type="text/plain", </sitemap.xml>; rel="describedby"; type="application/xml", </robots.txt>; rel="describedby"; type="text/plain"

  # HTML: toujours revalidé pour voir rapidement les mises à jour.
  # Pas de Cache-Control ici : la règle générale couvre tout et se concatène
  # à celle des assets (max-age=0 puis max-age=2592000), ce qui laisse le
  # navigateur retomber sur max-age=0 pour des fichiers immuables.

/
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/projets/*
  Cache-Control: public, max-age=0, must-revalidate

/*.txt
  Cache-Control: public, max-age=86400

/*.xml
  Cache-Control: public, max-age=86400

/css/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800

/js/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800

/videos/*
  Cache-Control: public, max-age=31536000, immutable

/audios/*
  Cache-Control: public, max-age=2592000

/cv/*
  Cache-Control: public, max-age=2592000

/docs/*
  Cache-Control: public, max-age=2592000
  ! X-Frame-Options
